# ActiveLearningAI — Cloud training environment
# Copy to project root as .env before starting:
#   cp deploy/.env.cloud .env

# LLM (Ollama)
OLLAMA_CODE_MODEL=deepseek-coder:6.7b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Neuromorphic brain scale
# Default: 220K neurons (~13GB). Uncomment for larger:
# NEURO_SPARSITY_SCALE=0.8  # reduce sparsity for smaller RAM footprint

# Video training
VIDEO_DIR=/data/videos
VIDEO_FPS=2.0
VIDEO_LOOPS=5

# Turbo training (remove bottlenecks for max throughput)
NEURO_QUEUE_SIZE=50
NEURO_LOOP_YIELD=0

# Gateway (runs outside Docker)
NATS_URL=nats://localhost:4222

# Dashboard
DASHBOARD_PORT=8080
